{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "handmark": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "hm",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "outputMode": "static",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "{robots.txt,sitemap.xml,site.webmanifest}",
                "input": "public",
                "output": "/"
              },
              {
                "glob": "**/*",
                "input": "public/assets",
                "output": "assets"
              },
              {
                "glob": "*.woff2",
                "input": "node_modules/@mikaelcedergren/cx-framework/fonts",
                "output": "assets/fonts"
              }
            ],
            "styles": [
              { "input": "src/styles/site.scss", "bundleName": "styles", "inject": false }
            ],
            "scripts": []
          },
          "configurations": {
            "local": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "prod": {
              "optimization": {
                "scripts": true,
                "styles": true,
                "fonts": true
              },
              "outputHashing": "all",
              "budgets": [
                { "type": "initial", "maximumWarning": "900kb", "maximumError": "1.2mb" },
                { "type": "anyComponentStyle", "maximumWarning": "16kb", "maximumError": "24kb" }
              ]
            }
          },
          "defaultConfiguration": "local"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "local": {
              "buildTarget": "handmark:build:local"
            }
          },
          "defaultConfiguration": "local"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        }
      }
    }
  },
  "cli": {
    "cache": {
      "enabled": false
    },
    "analytics": false
  }
}
