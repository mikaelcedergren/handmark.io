# This repository does not own a deployable nginx template.
#
# The live Handmark config is /opt/homebrew/etc/nginx/servers/handmark.io.conf. Shared nginx shape,
# rate limits, proxy behavior, ACME/TLS handling, validation, and reload procedures are owned by
# /Users/cortex/Development/server-ops and the root SERVER-STANDARD.md / GO-LIVE.md documents.
#
# Handmark-specific values only:
#   hostnames: handmark.io, www.handmark.io
#   upstream: 127.0.0.1:3000
