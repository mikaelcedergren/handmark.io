{
  "name": "handmark.io",
  "version": "0.2.0",
  "private": true,
  "description": "Password-protected Handmark sales and application flow for human-made work verification.",
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "ng serve --configuration local --host 127.0.0.1 --port 4230",
    "build": "ng build --configuration prod",
    "build:local": "ng build --configuration local",
    "serve": "node server/index.mjs",
    "start": "node server/index.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "e2e": "playwright test tests/e2e/handmark.spec.cjs --reporter=line --workers=1",
    "e2e:install": "playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/common": "^22.0.2",
    "@angular/compiler": "^22.0.2",
    "@angular/core": "^22.0.2",
    "@angular/platform-browser": "^22.0.2",
    "@angular/platform-server": "^22.0.2",
    "@angular/router": "^22.0.2",
    "@angular/ssr": "^22.0.3",
    "@mikaelcedergren/cx-framework": "github:mikaelcedergren/cx-framework#main",
    "compression": "^1.7.5",
    "express": "^4.21.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.2",
    "@playwright/test": "1.60.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3"
  }
}
