{
  "name": "handmark-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "cd .. && server/node_modules/.bin/tsx watch server/src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist', { force: true, recursive: true })\" && tsc -p tsconfig.build.json",
    "start": "cd .. && node server/dist/index.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "import:applications": "cd .. && node server/dist/import-applications.js"
  },
  "dependencies": {
    "@mikaelcedergren/cx-framework": "github:mikaelcedergren/cx-framework#main",
    "compression": "^1.8.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  }
}
